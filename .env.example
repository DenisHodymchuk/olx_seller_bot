# Telegram Bot Token (від @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Дозволений Telegram ID власника (щоб тільки ви могли керувати ботом, залиште пустим щоб дозволити всім)
ADMIN_USER_ID=

# OLX API (з вашого кабінету developer.olx.ua -> запит bubatg)
OLX_CLIENT_ID=202769
OLX_CLIENT_SECRET=your_olx_client_secret_here
OLX_REDIRECT_URI=https://bubatgshop-production.up.railway.app/

# Google Gemini API Key (для розумного перекладу та генерації продаючих описів з MakerWorld)
# Отримати безкоштовно: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Контактні дані для оголошень за замовчуванням
DEFAULT_CITY_NAME=Хмельницький
DEFAULT_CONTACT_NAME=Денис
DEFAULT_CONTACT_PHONE=0689531334
ADVERTISER_TYPE=business

# Порт для вбудованого веб-сервера (Railway підставляє автоматично через PORT)
PORT=8080
